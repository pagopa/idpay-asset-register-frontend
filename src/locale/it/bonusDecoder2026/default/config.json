{
  "roles": {
    "name": "default",
    "logicalName": "Utente Standard",
    "subRoles": {
      "default": {
        "logicalName": "Utente Standard",
        "permissions": {
          "tables": ["products"]
        }
      }
    },
    "errors": {
      "profileNotConfigured": "pages.products.profileNotConfigured"
    }
  },
  "categories": {
    "DS": {
      "labelKey": "categories.DS.label",
      "templateFormat": "csv",
      "enabledIn": { "upload": true, "filters": true }
    },
    "DT": {
      "labelKey": "categories.DT.label",
      "templateFormat": "csv",
      "enabledIn": { "upload": true, "filters": true }
    },
    "DTC": {
      "labelKey": "categories.DTC.label",
      "templateFormat": "csv",
      "enabledIn": { "upload": true, "filters": true }
    },
    "DTS": {
      "labelKey": "categories.DTS.label",
      "templateFormat": "csv",
      "enabledIn": { "upload": true, "filters": true }
    },
    "DTSC": {
      "labelKey": "categories.DTSC.label",
      "templateFormat": "csv",
      "enabledIn": { "upload": true, "filters": true }
    }
  },
  "templates": {
    "formats": {
      "csv": {
        "headers": ["Codice GTIN/EAN", "Codice Prodotto", "Categoria", "Marca", "Modello"],
        "fields": ["GTIN123ABC4567", "SKU98765", "{{category}}", "MarcaEsempio", "ModelloX100"]
      }
    },
    "categories": {
      "DS": { "format": "csv", "name": "Satellitare" },
      "DT": { "format": "csv", "name": "Terrestre" },
      "DTC": { "format": "csv", "name": "Terrestre via cavo" },
      "DTS": { "format": "csv", "name": "Terrestre e Satellitare" },
      "DTSC": { "format": "csv", "name": "Terrestre, Satellitare e via cavo" }
    }
  },
  "ui": {
    "tables": {
      "products": {
        "bulkRules": {
          "preventMixedStatus": true
        },
        "columns": [
          {
            "id": "gtinCode",
            "labelKey": "tables.products.columns.gtinCode",
            "sortable": true
          },
          {
            "id": "category",
            "labelKey": "tables.products.columns.category",
            "sortable": true
          },
          {
            "id": "status",
            "labelKey": "tables.products.columns.status",
            "sortable": true
          },
          {
            "id": "batchName",
            "labelKey": "tables.products.columns.batchName",
            "sortable": false
          }
        ],
        "filters": [
          {
            "id": "category",
            "type": "select",
            "labelKey": "tables.products.filters.category",
            "useInitiativeCategories": true
          },
          {
            "id": "status",
            "type": "select",
            "labelKey": "tables.products.filters.status"
          },
          {
            "id": "gtinCode",
            "type": "text",
            "labelKey": "tables.products.filters.gtinCode"
          },
          {
            "id": "productCode",
            "type": "text",
            "labelKey": "tables.products.filters.productCode"
          },
          {
            "id": "productFileId",
            "type": "select",
            "labelKey": "tables.products.filters.productFileId"
          }
        ],
        "selection": {
          "rules": {
            "invitalia": ["UPLOADED", "SUPERVISED"],
            "invitalia_admin": ["WAIT_APPROVED"]
          }
        },
        "defaultFiltersByRole": {
          "invitalia_admin": {
            "status": "WAIT_APPROVED"
          }
        },
        "detail": {
          "fields": [
            { "id": "productName", "labelKey": "pages.productDetail.productName" },
            { "id": "batchName", "labelKey": "pages.productDetail.batchName" },
            { "id": "gtinCode", "labelKey": "pages.productDetail.gtinCode" },
            { "id": "productCode", "labelKey": "pages.productDetail.productCode" },
            { "id": "category", "labelKey": "pages.productDetail.category" },
            { "id": "brand", "labelKey": "pages.productDetail.brand" },
            { "id": "model", "labelKey": "pages.productDetail.model" }
          ]
        }
      }
    }
  }
}
